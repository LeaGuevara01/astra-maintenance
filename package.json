{
  "name": "astra-maintenance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22.20.0 <23"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspace @astra/api",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "npm run seed --workspace @astra/api",
    "dev": "concurrently --kill-others \"npm run dev --workspace @astra/api\" \"npm run dev --workspace @astra/web\""
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "concurrently": "9.2.4",
    "prisma": "6.19.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
